# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
# SQLite on a persistent disk is fine for a small shop. PostgreSQL also works:
# DATABASE_URL=postgresql://user:pass@host:5432/sammiie
DATABASE_URL=sqlite:////data/sammiie.db
MEDIA_ROOT=/data/media
# Admin panel address: https://your-site/<ADMIN_PATH>/  — pick something hard to guess
ADMIN_PATH=manage
# First admin is created on container start if both are set (remove the password afterwards)
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_COOKIE_SECURE=1
TRUST_PROXY=1
PUBLIC_BASE_URL=https://example.ir
ORDER_HOLD_HOURS=48
# Online gateway (optional, off until set and switched on in the admin panel)
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=1
